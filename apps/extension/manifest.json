{
  "manifest_version": 3,
  "name": "FocusLit Bridge (dev)",
  "version": "0.1.0",
  "description": "M1 development bridge: reports only the FocusLit test page's URL/title to the desktop app over native messaging. The explicit test control may close that same test tab; no other tab is read or closed.",
  "key": "",
  "permissions": ["tabs", "nativeMessaging", "storage"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "minimum_chrome_version": "116"
}
